[Unit]
Description=QuantumCBT auto-submit ujian yang waktunya habis
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=quantumcbt
Group=quantumcbt
WorkingDirectory=/opt/quantumcbt/backend
ExecStart=/opt/quantumcbt/backend/venv/bin/python -m app.scripts.auto_submit_expired
TimeoutStartSec=300
