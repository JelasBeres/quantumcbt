# Environment variables template for frontend
# Copy this to .env.local and fill in with your own values

# API Configuration
# WAJIB tetap "/api" untuk HTTPS/tunnel: browser memanggil origin yang sama,
# Next.js mem-forward ke BACKEND_URL lewat rewrite di next.config.mjs.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Quantum Research CBT

# Backend URL (dipakai next.config.mjs rewrites, server-side only)
# Jangan pakai trailing slash. Contoh: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Frontend URL (for meta tags, etc)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Math/Rendering
NEXT_PUBLIC_KATEX_CDN=https://cdn.jsdelivr.net/npm/katex@0.16.9/dist

# Timeouts (ms)
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_AUTOSAVE_INTERVAL=5000

# Other
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
